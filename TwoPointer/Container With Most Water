class Solution {
public:
    int maxArea(vector<int>& height) {
        int left = 0;
        int right = height.size() - 1;
        int max_water = 0;

        while(left < right) {
            int w = right - left;
            int h = min(height[left], height[right]);
            int curr = w * h;

            max_water = max(curr, max_water);

            height[left] < height[right] ? left++ : right--;
        }

        return max_water;

        // Time Complexity: O(n)
        // Space Complexity: O(1)
    }
};
