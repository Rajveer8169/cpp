class Solution {
public:
    vector<int> maxSlidingWindow(vector<int>& nums, int k) {

        // Deque stores indices, not values
        // Values corresponding to indices are maintained
        // in decreasing order
        deque<int> dq;

        // Stores maximum element of each window
        vector<int> ans;

        for (int i = 0; i < nums.size(); i++) {

            // Remove indices that are outside the current window
            // Current window starts from: i - k + 1
            if (!dq.empty() && dq.front() <= i - k) {
                dq.pop_front();
            }

            // Remove smaller elements from the back
            // They can never become maximum because nums[i] is greater
            while (!dq.empty() && nums[dq.back()] <= nums[i]) {
                dq.pop_back();
            }

            // Add current index to the deque
            dq.push_back(i);

            // Window is complete when i >= k - 1
            if (i >= k - 1) {

                // Front always contains the index of maximum element
                ans.push_back(nums[dq.front()]);
            }
        }

        return ans;
    }

    // Time Complexity: O(n)
    // Each index is pushed into the deque once
    // and removed from the deque at most once.

    // Space Complexity: O(k)
    // At most k indices can be stored in the deque.
};
