class Solution {
public:
    int numSubarrayProductLessThanK(vector<int>& nums, int k) {

        // If k <= 1, no positive product can be less than k
        if (k <= 1) {
            return 0;
        }

        // Stores the product of the current window
        int product = 1;

        // Left pointer of the sliding window
        int left = 0;

        // Stores the total number of valid subarrays
        int ans = 0;

        // Right pointer expands the window
        for (int right = 0; right < nums.size(); right++) {

            // Include nums[right] in the product
            product *= nums[right];

            // If product is not less than k,
            // shrink the window from the left
            while (product >= k) {
                product /= nums[left];
                left++;
            }

            // Number of valid subarrays ending at right:
            // [right]
            // [right-1, right]
            // [right-2, right]
            // ...
            // [left, ..., right]
            ans += right - left + 1;
        }

        return ans;
    }

    // Time Complexity: O(n)
    // Each element is added to the window once
    // and removed from the window at most once.

    // Space Complexity: O(1)
    // Only a few variables are used.
};
