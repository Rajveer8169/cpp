#include <iostream>
using namespace std;

int main() {
    int start = 10;
    int end = 30;

    for (int n = start; n <= end; n++) {

        if (n <= 1)
            continue;

        bool isPrime = true;

        for (int i = 2; i * i <= n; i++) {
            if (n % i == 0) {
                isPrime = false;
                break;
            }
        }

        if (isPrime)
            cout << n << " ";
    }

    return 0;
}
