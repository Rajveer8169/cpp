class Solution {
public:

    int height(TreeNode* root) {

        // Base case: empty tree has height 0
        if (root == nullptr)
            return 0;

        int leftHeight = height(root->left);

        // If left subtree is already unbalanced, return -1
        if (leftHeight == -1)
            return -1;

        int rightHeight = height(root->right);

        // If right subtree is already unbalanced, return -1
        if (rightHeight == -1)
            return -1;

        // If height difference is greater than 1, tree is unbalanced
        if (abs(leftHeight - rightHeight) > 1)
            return -1;

        // Return height of current subtree
        return 1 + max(leftHeight, rightHeight);
    }

    bool isBalanced(TreeNode* root) {

        // If height returns -1, tree is not balanced
        return height(root) != -1;
    }

    // TC: O(N)
    // SC: O(H), where H = height of tree
    // Worst-case SC: O(N) for a skewed tree
};
