class Solution {
public:
    vector<int> preorderTraversal(TreeNode* root) {
        
        // If tree is empty, return an empty vector
        if(root == nullptr) return {};

        vector<int> ans;
        stack<TreeNode*> st;

        // Push root into stack
        st.push(root);

        while(!st.empty()) {

            // Get the top node and remove it from stack
            root = st.top();
            st.pop();

            // Preorder: Root -> Left -> Right
            ans.push_back(root->val);

            // Push right first
            // so that left is processed first
            if(root->right)
                st.push(root->right);

            // Push left after right
            if(root->left)
                st.push(root->left);
        }

        return ans;
    }
};

/*
Time Complexity: O(n)
- Every node is pushed into the stack once.
- Every node is popped from the stack once.
- Every node is visited once.
- Therefore, TC = O(n)

Space Complexity: O(n)
- The stack can contain up to O(n) nodes
  in the worst case (skewed tree).
- The answer vector also stores n nodes.
- Therefore, auxiliary stack space = O(n).
- Overall SC = O(n).
*/
