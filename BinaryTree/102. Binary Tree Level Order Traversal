class Solution {
public:
    vector<vector<int>> levelOrder(TreeNode* root) {

        vector<vector<int>> ans;

        // If tree is empty, return empty answer
        if (root == nullptr)
            return ans;

        // Queue stores nodes level by level
        queue<TreeNode*> q;

        q.push(root);

        while (!q.empty()) {

            // Number of nodes present at current level
            int size = q.size();

            vector<int> level;

            // Process all nodes of current level
            for (int i = 0; i < size; i++) {

                TreeNode* node = q.front();
                q.pop();

                // Add current node's value to the level
                level.push_back(node->val);

                // Add left child for next level
                if (node->left != nullptr)
                    q.push(node->left);

                // Add right child for next level
                if (node->right != nullptr)
                    q.push(node->right);
            }

            // Add current level to answer
            ans.push_back(level);
        }

        return ans;
    }

    // TC: O(N)
    // Every node is pushed into and removed from the queue once.

    // SC: O(N)
    // Queue can contain O(N) nodes in the worst case.
};
